class Solution {
    public int scoreOfString(String s) {
        int sum=0;
        for(int i=0;i<s.length()-1;i++)
        {
            char ch1 = s.charAt(i);
            int p1 = ch1;
            char ch2 = s.charAt(i+1);
            int p2 = ch2;
            sum=sum+Math.abs(p1-p2);
        }
        return sum;
    }
}
