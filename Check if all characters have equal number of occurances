class Solution {
    public boolean areOccurrencesEqual(String s) {
        HashMap<Character,Integer> hasha = new HashMap<Character,Integer>();
        int t=0;
        Set<Integer> hashset = new HashSet<Integer>();
        for(int i=0;i<s.length();i++)
        {
            char c = s.charAt(i);
            if(hasha.containsKey(c))
            {
                hasha.put(c,hasha.get(c)+1);
            }
            else
            {
                hasha.put(c,1);
            }
        }
        for(int i=0;i<s.length();i++)
        {
            hashset.add(hasha.get(s.charAt(i)));
        }
        System.out.println(hasha);
        System.out.println(hashset);
        if(hashset.size()==1)
        {
            return true;
        }
        else
        {
            return false;
        }
    }
}
