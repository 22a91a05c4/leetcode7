class Solution {
    public int[] getSneakyNumbers(int[] nums) {
        HashSet<Integer> hs = new HashSet<Integer>();
        int[] arr = new int[2];
        int j=0;
        for(int i=0;i<nums.length;i++)
        {
            if(hs.contains(nums[i]))
            {
                arr[j]=nums[i];
                j++;
            }
            else
            {
                hs.add(nums[i]);
            }
        }
        return arr;
    }
}
